# Copy this file to .env (in the backend folder) and fill in your own key.
# Never commit the .env file.

# Port for the backend server (optional, default 3001).
PORT=3001

# OpenAI API key (required). The backend uses it to make the business ideas.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
